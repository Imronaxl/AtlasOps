# === AtlasOps environment ===
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env

# --- Application ---
API_ENV=production
API_LOG_LEVEL=info
API_WORKERS=2

# --- PostgreSQL ---
POSTGRES_USER=infra_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=infra_monitor

# --- Redis ---
REDIS_PASSWORD=change_me_to_a_strong_redis_password

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_to_a_strong_admin_password
GF_USERS_ALLOW_SIGN_UP=false

# --- Prometheus ---
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB

# --- Frontend (Next.js) ---
# Optional. Defaults to http://localhost:8000
# In production, point this at your deployed API URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
