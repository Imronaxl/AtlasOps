# === AtlasOps environment ===
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env

# --- Application ---
API_ENV=production
# Bearer token Alertmanager sends to the API webhook.
ALERT_WEBHOOK_TOKEN=change_me_to_a_random_token

# --- PostgreSQL ---
POSTGRES_USER=infra_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=infra_monitor

# --- Redis ---
REDIS_PASSWORD=change_me_to_a_strong_redis_password

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_to_a_strong_admin_password
GF_USERS_ALLOW_SIGN_UP=false

# --- Prometheus ---
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB

# --- Dashboard (web/) ---
# Origin allowed to call the API from a browser, as a JSON list.
CORS_ORIGINS=["http://localhost:3001"]
