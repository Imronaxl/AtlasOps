POSTGRES_USER=infra_admin
POSTGRES_PASSWORD=changeme_postgres_secret
POSTGRES_DB=infra_monitor
POSTGRES_PORT=5432

REDIS_PASSWORD=changeme_redis_secret
REDIS_PORT=6379

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_LOG_LEVEL=info
API_ENV=production

PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana_secret
GF_USERS_ALLOW_SIGN_UP=false

ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_AUTH_USERNAME=alerts@example.com
ALERTMANAGER_SMTP_AUTH_PASSWORD=changeme_smtp_secret
ALERTMANAGER_WEBHOOK_URL=https://hooks.example.com/alerts

BACKUP_DIR=/opt/backups/infra-monitor
BACKUP_RETENTION_DAYS=7
