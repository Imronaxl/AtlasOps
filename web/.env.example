# AtlasOps dashboard environment
#
# Copy to .env.local and adjust if needed.
#   cp .env.example .env.local

# URL of the AtlasOps FastAPI backend.
# In local dev: http://localhost:8000 (where docker-compose exposes the API).
# In production: your deployed API URL.
#
# If the API is unreachable, the dashboard automatically falls back to
# mock data and shows a "demo" badge in the header.
NEXT_PUBLIC_API_URL=http://localhost:8000
